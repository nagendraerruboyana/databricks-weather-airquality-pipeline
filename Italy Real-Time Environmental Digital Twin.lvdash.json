{
  "datasets": [
    {
      "name": "1bd1bd86",
      "displayName": "Dashboard Data",
      "config": {
        "version": "1.1",
        "source": "SELECT *\r\nFROM weather.gold.current_environmen_metrics",
        "dimensions": [
          {
            "displayName": "City",
            "synonyms": [
              "location",
              "municipality",
              "city name",
              "urban area"
            ],
            "name": "city",
            "expr": "source.city",
            "comment": "Represents the city associated with each record in the dataset. Use this dimension to analyze data by geographic location or to filter results by specific cities."
          },
          {
            "displayName": "Latest Updated At",
            "format": {
              "type": "date_time",
              "leadingZeros": true,
              "dateFormat": "year_month_day",
              "timeFormat": "locale_hour_minute"
            },
            "synonyms": [
              "last updated",
              "most recent update",
              "updated timestamp",
              "latest modification time"
            ],
            "name": "latest_updated_at",
            "expr": "FROM_UTC_TIMESTAMP(source.latest_updated_at, 'GMT+2')",
            "comment": "Represents the most recent timestamp when the record was updated, converted to GMT+2. Use this dimension to track the latest changes made to the data."
          },
          {
            "displayName": "Temperature",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "all"
              },
              "abbreviation": "none",
              "hideGroupSeparator": false
            },
            "synonyms": [
              "temp",
              "degree Celsius",
              "temperature reading",
              "ambient temperature"
            ],
            "name": "temperature",
            "expr": "source.temperature",
            "comment": "Represents the temperature recorded in degrees, which can be used for analyzing weather patterns, climate trends, or any temperature-related metrics."
          },
          {
            "displayName": "Wind Speed",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "all"
              },
              "abbreviation": "none",
              "hideGroupSeparator": false
            },
            "synonyms": [
              "wind speed",
              "air speed",
              "velocity of wind",
              "wind velocity"
            ],
            "name": "wind_speed",
            "expr": "source.wind_speed",
            "comment": "Represents the speed of the wind measured in appropriate units, allowing users to analyze weather patterns and their impact on various metrics."
          },
          {
            "displayName": "Weather Code",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "all"
              },
              "abbreviation": "none",
              "hideGroupSeparator": false
            },
            "synonyms": [
              "weather condition",
              "weather type",
              "atmospheric condition",
              "climate status"
            ],
            "name": "weather_code",
            "expr": "source.weather_code",
            "comment": "Represents the weather condition associated with a specific observation, such as sunny, rainy, or cloudy. Use this dimension to filter or categorize data based on weather patterns."
          },
          {
            "displayName": "PM10 Levels",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "all"
              },
              "abbreviation": "none",
              "hideGroupSeparator": false
            },
            "synonyms": [
              "PM10 Concentration",
              "PM10 Particulate Matter",
              "Air Quality PM10",
              "PM10 Levels in Air"
            ],
            "name": "pm10",
            "expr": "source.pm10",
            "comment": "Represents the levels of PM10 particulate matter in the air, measured in micrograms per cubic meter (µg/m³). This dimension can be used to analyze air quality and its impact on health and the environment."
          },
          {
            "displayName": "PM2.5 Levels",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "all"
              },
              "abbreviation": "none",
              "hideGroupSeparator": false
            },
            "synonyms": [
              "PM2.5 concentration",
              "particulate matter 2.5",
              "air quality index",
              "fine particulate matter"
            ],
            "name": "pm2_5",
            "expr": "source.pm2_5",
            "comment": "Represents the concentration levels of PM2.5 particulate matter in the air, measured in micrograms per cubic meter (µg/m³). This dimension can be used to analyze air quality trends and assess environmental health impacts."
          },
          {
            "displayName": "Air Quality Status",
            "synonyms": [
              "air quality condition",
              "air quality level",
              "environmental air status",
              "air pollution status"
            ],
            "name": "air_quality_status",
            "expr": "source.air_quality_status",
            "comment": "Indicates the current air quality status, which can be used to assess environmental conditions and inform decisions related to health and safety."
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
